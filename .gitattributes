# Auto detect text files and normalize line endings to LF
* text=auto

# Source code files - use LF line endings
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf

# Image files - treat as binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary

# Git files
.gitignore text
.gitattributes text

# macOS system files
.DS_Store